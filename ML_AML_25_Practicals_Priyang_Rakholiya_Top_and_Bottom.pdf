BT 1 0 0 1 4 337.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_05\(\):) Tj T* (    X, y = make_classification\() Tj T* (        n_samples=100, n_features=5, n_informative=3,) Tj T* (        n_redundant=0, n_classes=2, random_state=42) Tj T* (    \)) Tj T*  T* (    loo = LeaveOneOut\(\)) Tj T* (    model = DecisionTreeClassifier\(random_state=42\)) Tj T* (    scores = []) Tj T*  T* (    for iteration, \(train_index, test_index\) in enumerate\(loo.split\(X\), start=1\):) Tj T* (        X_train, X_test = X[train_index], X[test_index]) Tj T* (        y_train, y_test = y[train_index], y[test_index]) Tj T*  T* (        model.fit\(X_train, y_train\)) Tj T* (        prediction = model.predict\(X_test\)) Tj T* (        score = accuracy_score\(y_test, prediction\)) Tj T* (        scores.append\(score\)) Tj T* (        print\(f"Iteration {iteration}: Accuracy = {score:.0f}"\)) Tj T*  T* (    print\("Average LOOCV Accuracy:", np.mean\(scores\)\)) Tj T*  T* (practical_05\(\)) Tj T* ET
Q
