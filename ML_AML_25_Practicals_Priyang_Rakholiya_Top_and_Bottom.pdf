BT 1 0 0 1 4 313.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_19\(\):) Tj T* (    rng = np.random.default_rng\(42\)) Tj T* (    X = rng.random\(\(100, 3\)\)) Tj T*  T* (    pca = PCA\(n_components=2\)) Tj T* (    X_reduced = pca.fit_transform\(X\)) Tj T*  T* (    print\("Original shape:", X.shape\)) Tj T* (    print\("Reduced shape:", X_reduced.shape\)) Tj T* (    print\("First five reduced rows:\\n", X_reduced[:5]\)) Tj T*  T* (    plt.figure\(figsize=\(8, 6\)\)) Tj T* (    plt.scatter\(X_reduced[:, 0], X_reduced[:, 1]\)) Tj T* (    plt.xlabel\("Principal Component 1"\)) Tj T* (    plt.ylabel\("Principal Component 2"\)) Tj T* (    plt.title\("PCA on 100 Random Samples \(3 Features to 2\)"\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_19\(\)) Tj T* ET
Q
