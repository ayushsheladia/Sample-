0 0 0 rg
BT 1 0 0 1 4 321.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_14\(\):) Tj T* (    rng = np.random.default_rng\(42\)) Tj T* (    X = rng.uniform\(0, 20, size=\(35, 2\)\)) Tj T*  T* (    fig, axes = plt.subplots\(2, 3, figsize=\(15, 9\)\)) Tj T* (    for ax, k in zip\(axes.ravel\(\), range\(2, 8\)\):) Tj T* (        model = KMeans\(n_clusters=k, random_state=42, n_init=10\)) Tj T* (        labels = model.fit_predict\(X\)) Tj T* (        ax.scatter\(X[:, 0], X[:, 1], c=labels, cmap="tab10", s=55\)) Tj T* (        ax.scatter\(model.cluster_centers_[:, 0], model.cluster_centers_[:, 1],) Tj T* (                   marker="X", s=160, edgecolor="black"\)) Tj T* (        ax.set_title\(f"Random 35 points \227 K={k}"\)) Tj T* (        ax.set_xlabel\("X"\)) Tj T* (        ax.set_ylabel\("Y"\)) Tj T*  T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T* (    print\("Impact: increasing K creates more, smaller clusters and reduces ") Tj T* (          "within-cluster variation, but may over-segment the data."\)) Tj T*  T* (practical_14\(\)) Tj T* ET
Q
