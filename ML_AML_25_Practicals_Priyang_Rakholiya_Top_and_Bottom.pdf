BT 1 0 0 1 4 313.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_17\(\):) Tj T* (    data = load_iris\(\)) Tj T* (    X = StandardScaler\(\).fit_transform\(data.data\)) Tj T* (    y = data.target) Tj T*  T* (    pca = PCA\(n_components=2\)) Tj T* (    X_pca = pca.fit_transform\(X\)) Tj T*  T* (    plt.figure\(figsize=\(8, 6\)\)) Tj T* (    for i, name in enumerate\(data.target_names\):) Tj T* (        plt.scatter\(X_pca[y == i, 0], X_pca[y == i, 1], label=name\)) Tj T* (    plt.xlabel\("Principal Component 1"\)) Tj T* (    plt.ylabel\("Principal Component 2"\)) Tj T* (    plt.title\("PCA on Standardized Iris Dataset"\)) Tj T* (    plt.legend\(\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T* (    print\("Explained variance ratio:", pca.explained_variance_ratio_\)) Tj T*  T* (practical_17\(\)) Tj T* ET
