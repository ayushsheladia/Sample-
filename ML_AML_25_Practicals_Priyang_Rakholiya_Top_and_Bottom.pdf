BT 1 0 0 1 4 353.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_08\(\):) Tj T* (    data = load_breast_cancer\(\)) Tj T* (    X_train, X_test, y_train, y_test = train_test_split\() Tj T* (        data.data, data.target, test_size=0.2, random_state=42,) Tj T* (        stratify=data.target) Tj T* (    \)) Tj T*  T* (    scaler = StandardScaler\(\)) Tj T* (    X_train = scaler.fit_transform\(X_train\)) Tj T* (    X_test = scaler.transform\(X_test\)) Tj T*  T* (    model = SVC\(kernel="rbf", C=1.0, gamma="scale"\)) Tj T* (    model.fit\(X_train, y_train\)) Tj T* (    predictions = model.predict\(X_test\)) Tj T*  T* (    print\("SVC Accuracy:", accuracy_score\(y_test, predictions\)\)) Tj T* (    ConfusionMatrixDisplay.from_predictions\() Tj T* (        y_test, predictions, display_labels=data.target_names,) Tj T* (        cmap="Blues") Tj T* (    \)) Tj T* (    plt.title\("SVC \227 Breast Cancer Confusion Matrix"\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_08\(\)) Tj T* ET
Q
