1 0 0 1 48.51969 322.3701 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 4 329.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_07\(\):) Tj T* (    df = pd.read_csv\("Social_Network_Ads.csv"\)) Tj T* (    X = df[["Age", "EstimatedSalary"]]) Tj T* (    y = df["Purchased"]) Tj T*  T* (    X_train, X_test, y_train, y_test = train_test_split\() Tj T* (        X, y, test_size=0.30, random_state=42, stratify=y) Tj T* (    \)) Tj T*  T* (    scaler = StandardScaler\(\)) Tj T* (    X_train_scaled = scaler.fit_transform\(X_train\)) Tj T* (    X_test_scaled = scaler.transform\(X_test\)) Tj T*  T* (    linear_svc = SVC\(kernel="linear", C=1.0\)) Tj T* (    rbf_svc = SVC\(kernel="rbf", C=1.0, gamma="scale"\)) Tj T*  T* (    for name, model in [\("Linear SVC", linear_svc\), \("RBF SVC", rbf_svc\)]:) Tj T* (        model.fit\(X_train_scaled, y_train\)) Tj T* (        prediction = model.predict\(X_test_scaled\)) Tj T* (        print\(name, "Accuracy:", accuracy_score\(y_test, prediction\)\)) Tj T*  T* (practical_07\(\)) Tj T* ET
Q
