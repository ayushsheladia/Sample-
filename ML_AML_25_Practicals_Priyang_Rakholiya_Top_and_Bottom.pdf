BT 1 0 0 1 4 305.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_03\(\):) Tj T* (    iris = load_iris\(\)) Tj T* (    X_train, X_test, y_train, y_test = train_test_split\() Tj T* (        iris.data, iris.target, test_size=0.2, random_state=42,) Tj T* (        stratify=iris.target) Tj T* (    \)) Tj T*  T* (    tree_max_leaf = DecisionTreeClassifier\(max_leaf_nodes=8, random_state=42\)) Tj T* (    tree_min_sample = DecisionTreeClassifier\(min_samples_leaf=5, random_state=42\)) Tj T*  T* (    tree_max_leaf.fit\(X_train, y_train\)) Tj T* (    tree_min_sample.fit\(X_train, y_train\)) Tj T*  T* (    print\("Accuracy \(max_leaf_nodes=8\):",) Tj T* (          accuracy_score\(y_test, tree_max_leaf.predict\(X_test\)\)\)) Tj T* (    print\("Accuracy \(min_samples_leaf=5\):",) Tj T* (          accuracy_score\(y_test, tree_min_sample.predict\(X_test\)\)\)) Tj T*  T* (practical_03\(\)) Tj T* ET
