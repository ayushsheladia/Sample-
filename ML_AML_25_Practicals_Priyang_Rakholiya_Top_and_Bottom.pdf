1 0 0 1 48.51969 234.3701 cm
%PreformattedPara
0 0 0 rg
BT 1 0 0 1 4 441.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_09\(\):) Tj T* (    data = load_iris\(\)) Tj T* (    X_train, X_test, y_train, y_test = train_test_split\() Tj T* (        data.data, data.target, test_size=0.2, random_state=42,) Tj T* (        stratify=data.target) Tj T* (    \)) Tj T*  T* (    scaler = StandardScaler\(\)) Tj T* (    X_train_scaled = scaler.fit_transform\(X_train\)) Tj T* (    X_test_scaled = scaler.transform\(X_test\)) Tj T*  T* (    model = SVC\(kernel="rbf", C=1.0, gamma="scale"\)) Tj T* (    model.fit\(X_train_scaled, y_train\)) Tj T* (    predictions = model.predict\(X_test_scaled\)) Tj T*  T* (    print\("SVC Accuracy:", accuracy_score\(y_test, predictions\)\)) Tj T*  T* (    # Reduce test data to 2D only for a simple result visualization.) Tj T* (    pca = PCA\(n_components=2\)) Tj T* (    X_test_2d = pca.fit_transform\(X_test_scaled\)) Tj T* (    plt.figure\(figsize=\(8, 6\)\)) Tj T* (    for class_id, class_name in enumerate\(data.target_names\):) Tj T* (        mask = y_test == class_id) Tj T* (        plt.scatter\(X_test_2d[mask, 0], X_test_2d[mask, 1],) Tj T* (                    label=f"Actual {class_name}", marker="o"\)) Tj T* (        pred_mask = predictions == class_id) Tj T* (        plt.scatter\(X_test_2d[pred_mask, 0], X_test_2d[pred_mask, 1],) Tj T* (                    label=f"Predicted {class_name}", marker="x"\)) Tj T* (    plt.xlabel\("Principal Component 1"\)) Tj T* (    plt.ylabel\("Principal Component 2"\)) Tj T* (    plt.title\("Iris SVC \227 Actual and Predicted Test Classes \(PCA view\)"\)) Tj T* (    plt.legend\(\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_09\(\)) Tj T* ET
Q
