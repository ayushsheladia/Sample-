BT 1 0 0 1 4 289.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_02\(\):) Tj T* (    iris = load_iris\(\)) Tj T* (    X_train, X_test, y_train, y_test = train_test_split\() Tj T* (        iris.data, iris.target, test_size=0.2, random_state=42,) Tj T* (        stratify=iris.target) Tj T* (    \)) Tj T*  T* (    dt = DecisionTreeClassifier\(random_state=42\)) Tj T* (    svm = SVC\(kernel="rbf"\)) Tj T*  T* (    dt.fit\(X_train, y_train\)) Tj T* (    svm.fit\(X_train, y_train\)) Tj T*  T* (    print\("Decision Tree Accuracy:", accuracy_score\(y_test, dt.predict\(X_test\)\)\)) Tj T* (    print\("SVM Accuracy:", accuracy_score\(y_test, svm.predict\(X_test\)\)\)) Tj T*  T* (practical_02\(\)) Tj T* ET
