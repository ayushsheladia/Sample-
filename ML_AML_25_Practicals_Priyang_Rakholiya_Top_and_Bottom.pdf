BT 1 0 0 1 4 289.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_15\(\):) Tj T* (    X, _ = make_moons\(n_samples=300, noise=0.08, random_state=42\)) Tj T*  T* (    model = DBSCAN\(eps=0.2, min_samples=5\)) Tj T* (    labels = model.fit_predict\(X\)) Tj T*  T* (    plt.figure\(figsize=\(8, 6\)\)) Tj T* (    plt.scatter\(X[:, 0], X[:, 1], c=labels, cmap="viridis", s=30\)) Tj T* (    plt.xlabel\("Feature 1"\)) Tj T* (    plt.ylabel\("Feature 2"\)) Tj T* (    plt.title\("DBSCAN Clustering \227 make_moons"\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (    print\("Cluster labels \(-1 means noise\):", np.unique\(labels\)\)) Tj T*  T* (practical_15\(\)) Tj T* ET
