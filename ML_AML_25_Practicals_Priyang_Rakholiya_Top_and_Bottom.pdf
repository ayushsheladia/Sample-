BT 1 0 0 1 4 361.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_18\(\):) Tj T* (    data = load_iris\(\)) Tj T* (    df = pd.DataFrame\(data.data, columns=data.feature_names\)) Tj T* (    df["target"] = data.target) Tj T*  T* (    print\("Dataset shape:", df.shape\)) Tj T* (    print\(df.head\(\)\)) Tj T*  T* (    # Standardization is recommended before PCA because features have) Tj T* (    # different scales.) Tj T* (    X = StandardScaler\(\).fit_transform\(data.data\)) Tj T* (    pca = PCA\(n_components=2\)) Tj T* (    X_pca = pca.fit_transform\(X\)) Tj T*  T* (    plt.figure\(figsize=\(8, 6\)\)) Tj T* (    for i, name in enumerate\(data.target_names\):) Tj T* (        plt.scatter\(X_pca[data.target == i, 0],) Tj T* (                    X_pca[data.target == i, 1], label=name\)) Tj T* (    plt.xlabel\("Principal Component 1"\)) Tj T* (    plt.ylabel\("Principal Component 2"\)) Tj T* (    plt.title\("Iris Dataset \227 PCA 2D"\)) Tj T* (    plt.legend\(\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_18\(\)) Tj T* ET
Q
