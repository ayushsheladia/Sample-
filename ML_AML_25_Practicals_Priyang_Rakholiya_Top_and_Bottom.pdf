BT 1 0 0 1 4 321.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_16\(\):) Tj T* (    rng = np.random.default_rng\(42\)) Tj T* (    data = rng.uniform\(0, 20, size=\(100, 5\)\)) Tj T* (    df = pd.DataFrame\(data, columns=["Column1", "Column2", "Column3",) Tj T* (                                     "Column4", "Column5"]\)) Tj T* (    X = df[["Column3", "Column4"]].values) Tj T*  T* (    model = DBSCAN\(eps=5, min_samples=5\)) Tj T* (    labels = model.fit_predict\(X\)) Tj T*  T* (    plt.figure\(figsize=\(8, 6\)\)) Tj T* (    plt.scatter\(X[:, 0], X[:, 1], c=labels, cmap="viridis", s=35\)) Tj T* (    plt.xlabel\("Column 3"\)) Tj T* (    plt.ylabel\("Column 4"\)) Tj T* (    plt.title\("DBSCAN on Random Dataset \(eps=5, min_samples=5\)"\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (    print\("Unique labels \(-1 indicates noise\):", np.unique\(labels\)\)) Tj T*  T* (practical_16\(\)) Tj T* ET
