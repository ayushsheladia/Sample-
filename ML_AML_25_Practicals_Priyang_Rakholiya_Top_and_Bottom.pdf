BT 1 0 0 1 4 417.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_11\(\):) Tj T* (    df = pd.read_csv\("Salary.csv"\)) Tj T* (    X = df[["years_of_experience"]]) Tj T* (    y = df["salary"]) Tj T*  T* (    model = LinearRegression\(\)) Tj T* (    model.fit\(X, y\)) Tj T* (    predictions = model.predict\(X\)) Tj T* (    residuals = y - predictions) Tj T*  T* (    print\("Slope:", model.coef_[0]\)) Tj T* (    print\("Intercept:", model.intercept_\)) Tj T*  T* (    plt.figure\(figsize=\(8, 5\)\)) Tj T* (    plt.scatter\(X, y, label="Actual data"\)) Tj T* (    plt.plot\(X, predictions, label="Best-fit line"\)) Tj T* (    plt.xlabel\("Years of Experience"\)) Tj T* (    plt.ylabel\("Salary"\)) Tj T* (    plt.title\("Simple Linear Regression \227 Salary"\)) Tj T* (    plt.legend\(\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (    plt.figure\(figsize=\(8, 5\)\)) Tj T* (    plt.scatter\(predictions, residuals\)) Tj T* (    plt.axhline\(y=0, linestyle="--"\)) Tj T* (    plt.xlabel\("Predicted Salary"\)) Tj T* (    plt.ylabel\("Residuals"\)) Tj T* (    plt.title\("Residual Plot"\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_11\(\)) Tj T* ET
