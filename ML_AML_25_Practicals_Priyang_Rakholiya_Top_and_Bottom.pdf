BT 1 0 0 1 4 345.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_12\(\):) Tj T* (    X = np.array\([) Tj T* (        [1, 2], [2, 1], [2, 3], [3, 2],) Tj T* (        [8, 8], [9, 8], [8, 9], [9, 10],) Tj T* (        [15, 2], [16, 3], [15, 4], [17, 2],) Tj T* (        [5, 14], [6, 15]) Tj T* (    ]\)) Tj T*  T* (    wcss = []) Tj T* (    k_values = range\(1, 8\)) Tj T* (    for k in k_values:) Tj T* (        model = KMeans\(n_clusters=k, random_state=42, n_init=10\)) Tj T* (        model.fit\(X\)) Tj T* (        wcss.append\(model.inertia_\)) Tj T*  T* (    plt.plot\(list\(k_values\), wcss, marker="o"\)) Tj T* (    plt.xlabel\("Number of Clusters \(K\)"\)) Tj T* (    plt.ylabel\("WCSS / Inertia"\)) Tj T* (    plt.title\("Elbow Method \227 14 Data Points"\)) Tj T* (    plt.xticks\(list\(k_values\)\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_12\(\)) Tj T* ET
