BT 1 0 0 1 4 281.6 Tm /F3 6.4 Tf 8 TL (import numpy as np) Tj T* (import pandas as pd) Tj T* (import matplotlib.pyplot as plt) Tj T*  T* (from sklearn.datasets import \() Tj T* (    load_iris, load_breast_cancer, load_wine, load_digits,) Tj T* (    make_classification, make_blobs, make_moons) Tj T* (\)) Tj T* (from sklearn.model_selection import train_test_split, LeaveOneOut) Tj T* (from sklearn.tree import DecisionTreeClassifier, plot_tree) Tj T* (from sklearn.svm import SVC) Tj T* (from sklearn.linear_model import LogisticRegression, LinearRegression) Tj T* (from sklearn.naive_bayes import GaussianNB) Tj T* (from sklearn.cluster import KMeans, DBSCAN) Tj T* (from sklearn.decomposition import PCA) Tj T* (from sklearn.discriminant_analysis import LinearDiscriminantAnalysis) Tj T* (from sklearn.preprocessing import StandardScaler) Tj T* (from sklearn.metrics import accuracy_score, ConfusionMatrixDisplay) Tj T*  T*  T* (def practical_01\(\):) Tj T* (    df = pd.read_csv\("diabetes.csv"\)) Tj T* (    X = df.drop\("label", axis=1\)) Tj T* (    y = df["label"]) Tj T*  T* (    model = DecisionTreeClassifier\(max_depth=3, random_state=42\)) Tj T* (    model.fit\(X, y\)  # Complete dataset used for training) Tj T*  T* (    plt.figure\(figsize=\(18, 9\)\)) Tj T* (    plot_tree\(model, feature_names=X.columns, class_names=["0", "1"],) Tj T* (              filled=True, rounded=True\)) Tj T* (    plt.title\("Decision Tree \227 Diabetes Dataset \(max_depth=3\)"\)) Tj T* (    plt.tight_layout\(\)) Tj T* (    plt.show\(\)) Tj T*  T* (practical_01\(\)) Tj T* ET
